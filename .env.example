# 复制本文件为 .env 后再填写。
DEEPSEEK_API_KEY=
OWNER_QQ=
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_ACCESS_TOKEN=

TIMEZONE=Asia/Shanghai
MONTHLY_BUDGET_CNY=500
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_INPUT_PRICE_PER_MILLION=2
DEEPSEEK_OUTPUT_PRICE_PER_MILLION=8

# DeepSeek 官方联网搜索；复用上方 API Key。
DEEPSEEK_SEARCH_ENABLED=true
DEEPSEEK_SEARCH_TIMEOUT_SECONDS=8
DEEPSEEK_SEARCH_PRICE_CNY_PER_REQUEST=0.01

# 群聊记忆：保留上限、本轮注入条数、FTS 补充条数。
GROUP_HISTORY_RETENTION=400
GROUP_CONTEXT_MESSAGES=80
GROUP_CONTEXT_FTS_LIMIT=16

# 全局限流：所有群聊、私聊、命令回执和提醒共用。
SEND_LIMIT_PER_MINUTE=20
SEND_LIMIT_PER_HOUR=30
SEND_LIMIT_PER_DAY=200

# NoneBot 基础配置。NAPCAT_WS_URL 会自动映射为 OneBot WebSocket 地址。
DRIVER=~websockets

